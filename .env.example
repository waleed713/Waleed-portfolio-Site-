# Admin login password (required)
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie (required)
AUTH_SECRET=replace-with-a-long-random-string
# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: forward contact-form messages to your email via https://web3forms.com
WEB3FORMS_KEY=
